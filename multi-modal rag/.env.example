# Multi-Modal RAG Environment Configuration
# Copy this file to .env and fill in your actual API keys

# OpenAI API Key (required for image processing and embeddings)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Groq API Key (required for text/table summarization)
GROQ_API_KEY=gsk_your-groq-api-key-here

# LangChain API Key (optional, for tracing and monitoring)
LANGCHAIN_API_KEY=lsv2_pt_your-langchain-api-key-here

# LangChain Tracing (optional)
LANGCHAIN_TRACING_V2=true

# Application Settings
PDF_FILENAME=attention.pdf
CONTENT_PATH=./content/
COLLECTION_NAME=multi_modal_rag

# Model Configuration
TEXT_MODEL=llama-3.1-8b-instant
IMAGE_MODEL=gpt-4o-mini
TEMPERATURE=0.5
MAX_CONCURRENCY=3

# PDF Processing Settings
MAX_CHARACTERS=10000
COMBINE_TEXT_UNDER_N_CHARS=2000
NEW_AFTER_N_CHARS=6000